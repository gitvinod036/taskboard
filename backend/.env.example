DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_LOG_LEVEL=INFO
SECURE_HSTS_SECONDS=31536000
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback/
GOOGLE_OAUTH_STATE_MAX_AGE=600
DEFAULT_FROM_EMAIL=no-reply@taskboard.local
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Google Gemini AI (server-side only; never exposed to the frontend).
# Google Gemini is the single AI provider. Provide up to four API keys in
# priority order. Blank values are ignored. If at least one numbered key is
# present, ONLY the numbered keys are used. If no numbered keys are present,
# the legacy GEMINI_API_KEY / AI_API_KEY is used (backwards compatible).
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
# Legacy single-key form, used when the numbered keys above are all blank.
GEMINI_API_KEY=
# Legacy alias kept for backwards compatibility; GEMINI_API_KEY wins when both are set.
AI_API_KEY=
# Legacy single-model configuration. Still supported as-is when AI_MODELS is unset.
AI_MODEL=gemini-3.6-flash
# Ordered comma-separated Gemini models (primary first, then fallbacks).
# The first model is preferred; each later model is only tried when the previous
# one fails with a retryable provider error (429 rate limit, quota exhausted,
# 5xx, model unavailable, transient network error).
# Example:
# AI_MODELS=gemini-3.6-flash,gemini-2.5-flash
# Per-attempt HTTP timeout in seconds (fallback models are tried sequentially).
AI_REQUEST_TIMEOUT=30
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
