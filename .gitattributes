# Normalize line endings repository-wide.
# - All text files are stored with LF in the repository (the index),
#   regardless of the contributor's OS or core.autocrlf setting.
# - Explicit source-file rules keep repository text handling consistent across platforms.

# - Binary assets are excluded explicitly.
* text=auto

# Source code: always LF in the repository
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.env.example text eol=lf

# Windows-specific scripts keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets - never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pyc binary
*.db binary
*.sqlite3 binary
